# Copie para .env e preencha. Gere valores aleatórios, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
EVOLUTION_API_KEY=
REDIS_PASSWORD=
POSTGRES_PASSWORD=

# Usadas pelo cardápio (app Flask), no ambiente do servidor:
# EVOLUTION_BASE_URL=http://127.0.0.1:8080
# EVOLUTION_INSTANCE=lanchonete
# SECRET_KEY=            (obrigatório em produção; gere com o comando acima)
# COOKIE_SECURE=1        (use quando o site estiver em HTTPS)
# TRUST_PROXY=1          (use atrás de Caddy/Nginx/Cloudflare Tunnel)

# Endereço público do cardápio (usado no cartaz com QR code), ex.: https://meucardapio.com.br
PUBLIC_URL=

# Este arquivo é lido automaticamente (ambiente.py) por servir.py, gunicorn e manage.py.
